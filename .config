# Print the generated docker command
YOSO_DEBUG_ENABLED="yes"
# Stop after printing the command
STOP_ON_DEBUG="no"

# YOSO defaults
DEFAULT_IMAGE_VERSION=8.4
DEFAULT_SHELL_USER=yoso
DEFAULT_NETWORK=yoso
DEFAULT_PORT=80

# Traefik defaults
TRAEFIK_VERSION=3.6
TRAEFIK_CONTAINER_NAME=traefik

# Docker defaults
CONTAINER_NAME_PATTERN=${PWD##*/}-yoso-$DEFAULT_IMAGE_VERSION-dev
WORKING_DIRECTORY=/var/www/html
ENTRYPOINT=zsh
